{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zcloud FileFlow",
  "version": "0.1.0",
  "identifier": "com.zclouddigitech.fileflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zcloud FileFlow",
        "width": 1360,
        "height": 900,
        "minWidth": 760,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Private, offline-first file conversion for Windows",
    "longDescription": "Zcloud FileFlow offers local file tools designed to work offline without uploading user files.",
    "category": "Utility"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main Zcloud FileFlow window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-convert-image",
    "allow-process-image",
    "allow-batch-process-images",
    "allow-get-image-metadata",
    "allow-check-file-exists"
  ]
}
